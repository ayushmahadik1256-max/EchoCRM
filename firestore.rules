rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDebrief(data) {
      return data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.clientName is string && data.clientName.size() <= 200
        && data.status in ['Open', 'Done']
        && data.rawTranscript is string && data.rawTranscript.size() <= 20000
        && data.emailSubject is string && data.emailSubject.size() <= 300
        && data.emailBody is string && data.emailBody.size() <= 10000;
    }

    function isValidUserProfile(data) {
      return data.userId == request.auth.uid;
    }

    match /debriefs/{debriefId} {
      allow get, delete: if isSignedIn()
        && isValidId(debriefId)
        && resource.data.userId == request.auth.uid;

      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(debriefId)
        && request.resource.data.userId == request.auth.uid
        && isValidDebrief(request.resource.data);

      allow update: if isSignedIn()
        && isValidId(debriefId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidDebrief(request.resource.data);
    }

    match /users/{userId} {
      allow get, delete: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId;

      allow list: if false;

      allow create, update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && isValidUserProfile(request.resource.data);
    }

    match /templates/{templateId} {
      allow get, delete: if isSignedIn()
        && isValidId(templateId)
        && resource.data.userId == request.auth.uid;

      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create, update: if isSignedIn()
        && isValidId(templateId)
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
