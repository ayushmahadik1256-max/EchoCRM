{
  "entities": {
    "debrief": {
      "title": "Debrief",
      "description": "A client call debrief record containing transcript, follow-up email, CRM fields, internal notes, and next step.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique debrief identifier"
        },
        "userId": {
          "type": "string",
          "description": "User identifier who owns this debrief"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp ISO string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp ISO string"
        },
        "status": {
          "type": "string",
          "enum": ["Open", "Done"],
          "description": "Debrief follow-up status"
        },
        "clientName": {
          "type": "string",
          "maxLength": 200,
          "description": "Client name"
        },
        "company": {
          "type": "string",
          "maxLength": 200,
          "description": "Company name"
        },
        "callDate": {
          "type": "string",
          "maxLength": 50,
          "description": "Date of call"
        },
        "dealStage": {
          "type": "string",
          "enum": ["Lead", "Discovery", "Proposal", "Negotiation", "Closed Won", "Closed Lost"],
          "description": "Sales pipeline deal stage"
        },
        "rawTranscript": {
          "type": "string",
          "maxLength": 20000,
          "description": "Raw dictated or typed voice note transcript"
        },
        "emailSubject": {
          "type": "string",
          "maxLength": 300,
          "description": "Subject line of client follow-up email"
        },
        "emailBody": {
          "type": "string",
          "maxLength": 10000,
          "description": "Body text of client follow-up email"
        },
        "emailTone": {
          "type": "string",
          "enum": ["Warm", "Professional", "Direct"],
          "description": "Tone applied to follow-up email"
        },
        "crm": {
          "type": "object",
          "description": "Structured CRM extraction fields"
        },
        "internalNote": {
          "type": "array",
          "description": "Internal team handoff bullets"
        },
        "nextStep": {
          "type": "object",
          "description": "Suggested immediate next action"
        }
      },
      "required": ["id", "userId", "clientName", "dealStage", "rawTranscript", "emailSubject", "emailBody", "status"]
    },
    "userProfile": {
      "title": "UserProfile",
      "description": "User account settings including configurable email signature and default preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User identifier matching auth UID"
        },
        "emailSignature": {
          "type": "string",
          "maxLength": 2000,
          "description": "User-configurable email signature"
        },
        "senderName": {
          "type": "string",
          "maxLength": 200,
          "description": "Sender display name"
        },
        "senderTitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Professional title or role"
        },
        "company": {
          "type": "string",
          "maxLength": 200,
          "description": "Consulting firm or agency name"
        },
        "phone": {
          "type": "string",
          "maxLength": 50,
          "description": "Phone number"
        },
        "website": {
          "type": "string",
          "maxLength": 200,
          "description": "Website URL"
        },
        "linkedinUrl": {
          "type": "string",
          "maxLength": 200,
          "description": "LinkedIn profile URL"
        },
        "appendSignature": {
          "type": "boolean",
          "description": "Whether to auto-append signature to emails"
        },
        "defaultTone": {
          "type": "string",
          "enum": ["Warm", "Professional", "Direct"],
          "description": "Default email tone"
        },
        "defaultDealStage": {
          "type": "string",
          "description": "Default pipeline stage"
        },
        "defaultTaskOffsetDays": {
          "type": "integer",
          "description": "Default next step due offset in days"
        },
        "defaultTaskPriority": {
          "type": "string",
          "enum": ["Low", "Medium", "High"],
          "description": "Default task priority"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp ISO string"
        }
      },
      "required": ["userId"]
    },
    "callTemplate": {
      "title": "CallTemplate",
      "description": "Reusable call debrief template with guided prompts and defaults.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Template unique ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner userId"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Template name"
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "Template description"
        },
        "prompts": {
          "type": "array",
          "description": "Suggested questions for dictation"
        },
        "defaultDealStage": {
          "type": "string",
          "description": "Default deal stage"
        },
        "preferredTone": {
          "type": "string",
          "description": "Preferred email tone"
        },
        "requiredFields": {
          "type": "array",
          "description": "Required CRM fields"
        },
        "isCustom": {
          "type": "boolean",
          "description": "Whether this is user-created"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "name"]
    }
  },
  "firestore": {
    "/debriefs/{debriefId}": {
      "schema": "debrief",
      "description": "User call debrief records secured by owner userId"
    },
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile and preferences secured to the authenticated owner"
    },
    "/templates/{templateId}": {
      "schema": "callTemplate",
      "description": "Call templates secured by owner userId"
    }
  }
}
